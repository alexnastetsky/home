{
  "name": "home",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:worldcup": "tsc -b tsconfig.worldcup.json && vite build --config apps/worldcup/client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build:todolist": "tsc -b tsconfig.todolist.json && vite build --config apps/todolist/client/vite.config.ts",
    "build": "npm run build:server && npm run build:worldcup && npm run build:todolist",
    "dev:worldcup": "vite --config apps/worldcup/client/vite.config.ts",
    "dev:todolist": "vite --config apps/todolist/client/vite.config.ts",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.worldcup.json && tsc -b tsconfig.todolist.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run && npm run test:smoke",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "ship": "databricks apps validate --profile DEFAULT && databricks apps deploy --profile DEFAULT && npm run verify:deploy",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "clean": "rm -rf apps/worldcup/client/dist apps/todolist/client/dist dist build node_modules .smoke-test test-results playwright-report",
    "postinstall": "npm run typegen",
    "prebuild": "npm run sync && npm run typegen",
    "predev": "npm run sync && npm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "Shell app hosting the world cup pool (/worldcup) and the todolist (/todolist)",
  "dependencies": {
    "@databricks/appkit": "0.38.1",
    "@databricks/appkit-ui": "0.38.1",
    "@databricks/sdk-experimental": "0.17.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "0.546.0",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.13.0",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.37.0",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "5.0.5",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "prettier": "3.6.2",
    "sharp": "0.34.5",
    "tailwindcss": "4.0.14",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.0.14"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14"
  }
}
